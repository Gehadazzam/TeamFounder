{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/.venv": true,
    "**/.idea": true,
    "**/.env": true,
  },
  "python.analysis.extraPaths": [
    "backend"
  ],
  "python.defaultInterpreterPath": "backend/.venv/bin/python",
  "python.analysis.typeCheckingMode": "basic",
  "editor.formatOnSave": true,
}